# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable Key (sb_publishable_...) – der alte "anon" Key funktioniert hier ebenfalls
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Google AI Studio → API Key (bleibt serverseitig, kein NEXT_PUBLIC_!)
GEMINI_API_KEY=xxx
GEMINI_MODEL=gemini-3.5-flash

# Dein Vorname für die Begrüßung
NEXT_PUBLIC_OWNER_NAME=Justus

# School Hub (Apps-Script-Backend) – für „Berufsschultage einblenden“
# URL aus school-hub/config.js (endet auf /exec), Schlüssel = dein persönlicher ?k=… Wert
SCHOOL_HUB_API_URL=https://script.google.com/macros/s/…/exec
SCHOOL_HUB_KEY=dein-hub-schluessel
